@st.cache_data(ttl=90)
def fetch_complete_market_matrix(sess_factor):
    symbols = list(TICKERS_MASTER.keys())
    data = yf.download(symbols, period="1y", interval="1d", group_by="ticker", progress=False)
    processed, rejected = [], []
    diag_log = {"findings": [], "auto_healed": [], "action_required": []}
    
    for sym, (name, sector) in TICKERS_MASTER.items():
        t_code = sym.replace(".SR", "")
        if sym not in data:
            rejected.append({"الرمز": t_code, "الشركة": name, "القطاع": sector, "السبب": "انقطاع مؤقت في التغذية"})
            diag_log["action_required"].append(f"السهم {name} ({t_code}): لا توجد استجابة لحظية من السيرفر.")
            continue
            
        df = data[sym].dropna(how="all")
        if "Volume" in df.columns:
            df = df[df["Volume"] > 0]
            
        if len(df) < 25:
            rejected.append({"الرمز": t_code, "الشركة": name, "القطاع": sector, "السبب": "تاريخ تداول غير كافٍ"})
            continue
            
        c_series = df["Close"]
        c = c_series.values
        v = df["Volume"].values
        h = df["High"].values
        l = df["Low"].values
        o = df["Open"].values
        last_date = str(df.index[-1].strftime("%Y-%m-%d"))
        
        cur_p = round(float(c[-1]), 2)
        prev_p = round(float(c[-2]), 2)
        chg = round(((cur_p - prev_p) / prev_p) * 100, 2)
        
        # مؤشرات فنية قياسية
        rsi = calculate_wilder_rsi(c_series)
        
        tp = (h[-14:] + l[-14:] + c[-14:]) / 3
        raw_flow = tp * v[-14:]
        pos_flow = np.sum(np.where(tp[1:] > tp[:-1], raw_flow[1:], 0))
        neg_flow = np.sum(np.where(tp[1:] < tp[:-1], raw_flow[1:], 0))
        mfi = round(float(100 - (100 / (1 + (pos_flow / (neg_flow + 1e-9))))), 1)
        
        # الحجم النسبي المصحح بمعامل وقت التداول
        vol_avg20 = np.mean(v[-20:])
        expected_vol = vol_avg20 * sess_factor
        rvol = round(float(v[-1] / (expected_vol + 1e-9)), 2)
        
        sma20 = round(float(np.mean(c[-20:])), 2)
        sma50 = round(float(np.mean(c[-50:]) if len(c) >= 50 else np.mean(c)), 2)
        
        # الشفاء الذاتي للمتوسطات لحديثي الإدراج
        if len(c) >= 200:
            sma200 = round(float(np.mean(c[-200:])), 2)
            is_new_ipo = False
        else:
            sma200 = sma50
            is_new_ipo = True
            diag_log["auto_healed"].append(f"سهم {name} ({t_code}): إدراج حديث ({len(c)} يوم) - تم توفيق متوسط 200 يوم تلقائياً.")
            
        tr = np.maximum(h[-14:] - l[-14:], np.maximum(np.abs(h[-14:] - c[-15:-1]), np.abs(l[-14:] - c[-15:-1])))
        atr = round(float(np.mean(tr)), 2)
        
        up_move = h[-14:] - h[-15:-1]
        down_move = l[-15:-1] - l[-14:]
        pos_dm = np.where((up_move > down_move) & (up_move > 0), up_move, 0)
        neg_dm = np.where((down_move > up_move) & (down_move > 0), down_move, 0)
        plus_di = 100 * (np.mean(pos_dm) / (atr + 1e-9))
        minus_di = 100 * (np.mean(neg_dm) / (atr + 1e-9))
        adx = round(float(100 * np.abs(plus_di - minus_di) / (plus_di + minus_di + 1e-9)), 1)
        
        lowest_low = np.min(l[-14:])
        highest_high = np.max(h[-14:])
        stoch_k = round(float(100 * ((c[-1] - lowest_low) / (highest_high - lowest_low + 1e-9))), 1)
        high_52w = np.max(h)
        dist_high = round(float(((cur_p - high_52w) / high_52w) * 100), 1)
        donchian_high20 = np.max(h[-20:])
        
        # MFE / MAE لآخر 5 جلسات
        high_last5 = np.max(h[-5:])
        low_last5 = np.min(l[-5:])
        ref_price = c[-5]
        mfe = round(float(((high_last5 - ref_price) / ref_price) * 100), 2)
        mae = round(float(((low_last5 - ref_price) / ref_price) * 100), 2)
        
        score = 50
        if rsi < 36: score += 15
        if cur_p >= sma20: score += 10
        if cur_p >= sma50: score += 10
        if rvol >= 1.3: score += 15
        if mfi >= 55: score += 10
        if chg > 0: score += 10
        
        processed.append({
            "ticker": t_code, "name": name, "sector": sector, "price": cur_p, "last_date": last_date,
            "open": round(float(o[-1]), 2), "high": round(float(h[-1]), 2), "low": round(float(l[-1]), 2),
            "change": chg, "rsi": rsi, "mfi": mfi, "rvol": rvol, "sma20": sma20, "sma50": sma50,
            "sma200": sma200, "atr": atr, "adx": adx, "stoch_k": stoch_k, "dist_high": dist_high,
            "donchian_high": donchian_high20, "mfe": mfe, "mae": mae, "is_new_ipo": is_new_ipo,
            "score": min(100, max(0, score))
        })
        
    diag_log["findings"].append(f"تم فحص {len(processed)} شركة مؤهلة واستبعاد {len(rejected)} شركات لعدم كفاية الشموع.")
    diag_log["findings"].append(f"تم ربط التوقيت بالساعة الرسمية لتاسي (الرياض UTC+3) بنجاح.")
    return pd.DataFrame(processed), pd.DataFrame(rejected), diag_log

